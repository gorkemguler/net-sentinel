# ---------------------------------------------------------------------------
# NetSentinel configuration. Copy to `.env` and edit.
# Every key can also be set as a real environment variable (systemd, Docker).
# ---------------------------------------------------------------------------

# hub | sensor  -- which role this process runs.
NETSENTINEL_ROLE=hub

# Writable state dir (SQLite DB, caches). Put it on persistent storage.
NETSENTINEL_DATA_DIR=./var

NETSENTINEL_LOG_LEVEL=INFO

# Shared secret for sensor -> hub calls and token-protected API routes.
# Generate with:  netsentinel gen-token
NETSENTINEL_API_TOKEN=change-me-please

# --- hub -------------------------------------------------------------------
NETSENTINEL_HUB_HOST=0.0.0.0
NETSENTINEL_HUB_PORT=8080

# Optional HTTP-basic gate for the browser dashboard (leave blank = open).
NETSENTINEL_DASHBOARD_USER=
NETSENTINEL_DASHBOARD_PASSWORD=

# Retention windows (housekeeping runs every 6h).
NETSENTINEL_DNS_RETENTION_DAYS=14
NETSENTINEL_EVENT_RETENTION_DAYS=90

# Notifications: none | log | ntfy | telegram | webhook
NETSENTINEL_NOTIFY_BACKEND=log
NETSENTINEL_NTFY_URL=https://ntfy.sh
NETSENTINEL_NTFY_TOPIC=
NETSENTINEL_TELEGRAM_BOT_TOKEN=
NETSENTINEL_TELEGRAM_CHAT_ID=
NETSENTINEL_WEBHOOK_URL=

# Threat-intel enrichment for external IPs / domains.
NETSENTINEL_TI_ENABLED=true
NETSENTINEL_ABUSEIPDB_API_KEY=
NETSENTINEL_BLOCKLIST_PATH=./data/blocklist.txt

# --- sensor --------------------------------------------------------------
NETSENTINEL_HUB_URL=http://127.0.0.1:8080
NETSENTINEL_SENSOR_ID=sensor-1
NETSENTINEL_MONITOR_INTERFACE=eth0

# The ONLY range the sensor is allowed to discover / port-scan.
NETSENTINEL_LOCAL_SUBNET=192.168.1.0/24

NETSENTINEL_DISCOVERY_INTERVAL_SECONDS=300
NETSENTINEL_PORTSCAN_INTERVAL_SECONDS=3600
NETSENTINEL_DNS_FLUSH_INTERVAL_SECONDS=60
NETSENTINEL_PORTSCAN_NMAP_ARGS=-sS -T3 --top-ports 200 -Pn
